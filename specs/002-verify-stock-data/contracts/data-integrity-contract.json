{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DataIntegrityContract",
  "description": "Schema defining strict typing, primary source URL requirements, and mathematical consistency for all Airbus Strikes Analysis datasets.",
  "type": "object",
  "required": [
    "parameters",
    "stock_market_analysis",
    "company_solvency",
    "plant_census",
    "union_shares",
    "referendum_24j",
    "historical_purchasing_power_losses",
    "sources_catalog"
  ],
  "properties": {
    "stock_market_analysis": {
      "type": "object",
      "required": [
        "ticker",
        "primary_source",
        "source_url",
        "current_price_eur",
        "total_shares_outstanding",
        "current_market_cap_eur_m",
        "market_cap_lost_conflict_eur_m",
        "financial_asymmetry_ratio",
        "daily_history_conflict"
      ],
      "properties": {
        "ticker": { "type": "string" },
        "source_url": { "type": "string", "format": "uri" },
        "current_price_eur": { "type": "number", "minimum": 50, "maximum": 500 },
        "total_shares_outstanding": { "type": "integer", "minimum": 790000000, "maximum": 795000000 },
        "current_market_cap_eur_m": { "type": "number", "minimum": 100000 },
        "financial_asymmetry_ratio": { "type": "number", "minimum": 10 },
        "daily_history_conflict": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["date", "price", "event"],
            "properties": {
              "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
              "price": { "type": "number", "minimum": 50, "maximum": 500 },
              "event": { "type": "string", "minLength": 5 }
            }
          }
        }
      }
    }
  }
}
