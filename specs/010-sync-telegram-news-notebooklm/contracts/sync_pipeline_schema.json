{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SyncStatusSchema",
  "type": "object",
  "required": [
    "last_sync",
    "status",
    "news_count",
    "telegram_docs_count",
    "notebooklm_sync"
  ],
  "properties": {
    "last_sync": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": ["OK", "WARNING", "ERROR"]
    },
    "news_count": {
      "type": "integer",
      "minimum": 0
    },
    "telegram_docs_count": {
      "type": "integer",
      "minimum": 0
    },
    "notebooklm_sync": {
      "type": "object",
      "required": ["status", "uploaded_count"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["SKIPPED", "SUCCESS", "FAILED", "OFFLINE"]
        },
        "uploaded_count": {
          "type": "integer",
          "minimum": 0
        },
        "last_attempt": {
          "type": "string"
        }
      }
    }
  }
}
