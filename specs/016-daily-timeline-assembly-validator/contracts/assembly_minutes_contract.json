{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TimelineMilestoneList",
  "description": "Schema for timeline milestones array with assembly minutes integration",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "date",
      "display_date",
      "actor",
      "actor_category",
      "site",
      "title",
      "summary",
      "verified"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "date": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "display_date": {
        "type": "string"
      },
      "time": {
        "type": "string"
      },
      "actor": {
        "type": "string"
      },
      "actor_category": {
        "type": "string",
        "enum": ["company", "union", "sima", "assembly", "media", "government"]
      },
      "site": {
        "type": "string"
      },
      "title": {
        "type": "string"
      },
      "summary": {
        "type": "string"
      },
      "key_points": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "source_type": {
        "type": "string"
      },
      "document_id": {
        "type": ["string", "null"]
      },
      "source_url": {
        "type": ["string", "null"]
      },
      "verified": {
        "type": "boolean"
      }
    }
  }
}
